. /lib/functions.sh

case "$(board_name)" in
	glinet,gl-mt3600be)
		# root: locked (login via admin user only)
		passwd -l root

		# admin: uid 0 root-equivalent alias, password 'admin'
		grep -q '^admin:' /etc/passwd || echo 'admin:x:0:0:admin:/root:/bin/ash' >> /etc/passwd
		grep -q '^admin:' /etc/shadow || echo 'admin:$6$9WSg/m6PIm5UiqJg$de9kd97zF0Sq3UroAHtH/gB35bLtJlkUArU27Ya2vF2H8WDSz4Jl503husd2wBipeJKRQmU46Sg9EgZSKrwH/1::0:99999:7:::' >> /etc/shadow

		# derive suffix from last 4 hex digits of label MAC (eth0 = gmac0)
		suffix="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':' | tr 'a-z' 'A-Z' | cut -c9-12)"
		[ ${#suffix} -eq 4 ] || suffix="0000"

		uci -q set wireless.default_radio0.disabled='0'
		uci -q set wireless.default_radio1.disabled='0'
		uci -q set wireless.default_radio0.ssid="GL-MT3600BE-${suffix}"
		uci -q set wireless.default_radio1.ssid="GL-MT3600BE-${suffix}-5G"
		uci -q set wireless.default_radio0.encryption='psk2'
		uci -q set wireless.default_radio1.encryption='psk2'
		uci -q set wireless.default_radio0.key='88888888'
		uci -q set wireless.default_radio1.key='88888888'

		uci -q set wireless.guest_radio0='wifi-iface'
		uci -q set wireless.guest_radio0.device='radio0'
		uci -q set wireless.guest_radio0.mode='ap'
		uci -q set wireless.guest_radio0.network='guest'
		uci -q set wireless.guest_radio0.ssid="GL-MT3600BE-${suffix}-Guest"
		uci -q set wireless.guest_radio0.encryption='psk2'
		uci -q set wireless.guest_radio0.key='88888888'
		uci -q set wireless.guest_radio0.disabled='1'

		uci -q set wireless.guest_radio1='wifi-iface'
		uci -q set wireless.guest_radio1.device='radio1'
		uci -q set wireless.guest_radio1.mode='ap'
		uci -q set wireless.guest_radio1.network='guest'
		uci -q set wireless.guest_radio1.ssid="GL-MT3600BE-${suffix}-Guest-5G"
		uci -q set wireless.guest_radio1.encryption='psk2'
		uci -q set wireless.guest_radio1.key='88888888'
		uci -q set wireless.guest_radio1.disabled='1'
		uci commit wireless

		uci -q set network.guest_dev='device'
		uci -q set network.guest_dev.type='bridge'
		uci -q set network.guest_dev.name='br-guest'
		uci -q set network.guest_dev.bridge_empty='1'
		uci -q set network.guest='interface'
		uci -q set network.guest.device='br-guest'
		uci -q set network.guest.proto='static'
		uci -q set network.guest.ipaddr='192.168.4.1'
		uci -q set network.guest.netmask='255.255.255.0'

		uci -q set network.wan2='interface'
		uci -q set network.wan2.proto='dhcp'
		uci -q set network.wan2.metric='30'
		uci -q set network.wan2_6='interface'
		uci -q set network.wan2_6.proto='none'

		uci -q set network.lan.ipaddr='192.168.3.1'
		uci -q set network.lan.netmask='255.255.255.0'
		uci commit network

		uci -q set dhcp.guest='dhcp'
		uci -q set dhcp.guest.interface='guest'
		uci -q set dhcp.guest.start='100'
		uci -q set dhcp.guest.limit='150'
		uci -q set dhcp.guest.leasetime='12h'
		uci -q set dhcp.guest.ignore='1'
		uci commit dhcp

		uci -q set firewall.guest='zone'
		uci -q set firewall.guest.name='guest'
		uci -q set firewall.guest.input='REJECT'
		uci -q set firewall.guest.output='ACCEPT'
		uci -q set firewall.guest.forward='REJECT'
		uci -q add_list firewall.guest.network='guest'

		uci -q set firewall.guest_dns='rule'
		uci -q set firewall.guest_dns.name='Allow-Guest-DNS'
		uci -q set firewall.guest_dns.src='guest'
		uci -q set firewall.guest_dns.dest_port='53'
		uci -q set firewall.guest_dns.proto='tcp udp'
		uci -q set firewall.guest_dns.target='ACCEPT'

		uci -q set firewall.guest_dhcp='rule'
		uci -q set firewall.guest_dhcp.name='Allow-Guest-DHCP'
		uci -q set firewall.guest_dhcp.src='guest'
		uci -q set firewall.guest_dhcp.dest_port='67-68'
		uci -q set firewall.guest_dhcp.proto='udp'
		uci -q set firewall.guest_dhcp.target='ACCEPT'

		uci -q set firewall.guest_wan='forwarding'
		uci -q set firewall.guest_wan.src='guest'
		uci -q set firewall.guest_wan.dest='wan'

		uci -q del_list firewall.@zone[1].network='wan2'
		uci -q add_list firewall.@zone[1].network='wan2'

		uci -q set firewall.openclash='rule'
		uci -q set firewall.openclash.name='Allow-OpenClash'
		uci -q set firewall.openclash.src='wan'
		uci -q set firewall.openclash.dest_port='7874 7890 7891 7892 7893 7895 9090'
		uci -q set firewall.openclash.proto='tcp'
		uci -q set firewall.openclash.family='any'
		uci -q set firewall.openclash.target='ACCEPT'

		uci -q set firewall.adguardhome='rule'
		uci -q set firewall.adguardhome.name='Allow-AdGuardHome'
		uci -q set firewall.adguardhome.src='wan'
		uci -q set firewall.adguardhome.dest_port='3000'
		uci -q set firewall.adguardhome.proto='tcp'
		uci -q set firewall.adguardhome.family='any'
		uci -q set firewall.adguardhome.target='ACCEPT'
		uci commit firewall

		uci -q set openclash.config.core_type='Meta'
		uci -q set openclash.config.enable='0'
		uci commit openclash

		# ZeroTier: identity secret auto-generated on first start and written
		# back to uci; network join is triggered by an empty
		# /var/lib/zerotier-one/networks.d/<id>.conf created by the init script.
		# Never blank an existing secret: a kept-config upgrade or an
		# unexpected uci-defaults re-run would otherwise orphan the node in
		# the ltnet controller (fresh identity = ACCESS_DENIED after reboot).
		uci -q set zerotier.global='zerotier'
		uci -q set zerotier.global.enabled='1'
		uci -q get zerotier.global.secret >/dev/null || uci -q set zerotier.global.secret=''
		uci -q set zerotier.ltnet='network'
		uci -q set zerotier.ltnet.id='466270de75000001'
		uci -q set zerotier.ltnet.allow_managed='1'
		uci -q set zerotier.ltnet.allow_global='0'
		uci -q set zerotier.ltnet.allow_default='0'
		uci -q set zerotier.ltnet.allow_dns='0'
		uci commit zerotier

		# Bind the zt+ devices to a firewall zone so the ltnet overlay
		# and the travel LAN can reach each other (routes are managed by
		# the ltnet controller; no masquerade to keep source IPs)
		uci -q set network.zerotier='interface'
		uci -q set network.zerotier.device='zt+'
		uci -q set network.zerotier.proto='none'
		uci commit network

		uci -q set firewall.zt_zone='zone'
		uci -q set firewall.zt_zone.name='zerotier'
		uci -q add_list firewall.zt_zone.network='zerotier'
		uci -q add_list firewall.zt_zone.devices='zt+'
		uci -q set firewall.zt_zone.input='ACCEPT'
		uci -q set firewall.zt_zone.output='ACCEPT'
		uci -q set firewall.zt_zone.forward='REJECT'
		uci -q set firewall.zt_fwd_lan='forwarding'
		uci -q set firewall.zt_fwd_lan.src='zerotier'
		uci -q set firewall.zt_fwd_lan.dest='lan'
		uci -q set firewall.zt_fwd_zt='forwarding'
		uci -q set firewall.zt_fwd_zt.src='lan'
		uci -q set firewall.zt_fwd_zt.dest='zerotier'
		uci commit firewall
	;;
esac

exit 0
